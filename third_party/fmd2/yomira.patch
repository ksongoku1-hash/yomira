+function YomiraStageHasRoom(const ADirectory: string; const ABytes: Int64): Boolean;
+var
+  Search: TSearchRec;
+  Total: Int64;
+begin
+  Result := False;
+  if (ABytes <= 0) or (ABytes > 67108864) then Exit;
+  Total := ABytes;
+  // ponytail: scan one chapter under its task lock; keep a counter if large jobs need it.
+  if FindFirst(IncludeTrailingPathDelimiter(ADirectory) + '*', faAnyFile, Search) = 0 then
+  begin
+    repeat
+      if (Search.Attr and faDirectory) = 0 then Inc(Total, Search.Size);
+    until FindNext(Search) <> 0;
+    FindClose(Search);
+  end;
+  // The raw copy and Yomira's validated copy fit inside its 2 GiB page reservation.
+  Result := Total <= 536870912;
+end;
