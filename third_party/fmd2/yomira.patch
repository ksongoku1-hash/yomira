+function LuaLoadFileUTF8(const L: Plua_State; const AFileName: String): Integer;
+var
+  Source: THandleStream;
+  SourceHandle: THandle;
+  Buffer: RawByteString;
+  Offset: SizeInt;
+  ChunkName: String;
+begin
+  // Lua's Windows fopen cannot read UTF-8 paths; Lazarus uses the Unicode API.
+  try
+    SourceHandle := FileOpenUTF8(AFileName, fmOpenRead or fmShareDenyWrite);
+    if SourceHandle = THandle(-1) then RaiseLastOSError;
+    try
+      Source := THandleStream.Create(SourceHandle);
+      try
+        SetLength(Buffer, Source.Size);
+        if Length(Buffer) > 0 then Source.ReadBuffer(Buffer[1], Length(Buffer));
+      finally
+        Source.Free;
+      end;
+    finally
+      FileClose(SourceHandle);
+    end;
+  except
+    on E: Exception do
+    begin
+      lua_pushstring(L, PAnsiChar('cannot open ' + AFileName + ': ' + E.Message));
+      Exit(LUA_ERRFILE);
+    end;
+  end;
+  Offset := 1;
+  if Copy(Buffer, 1, 3) = #$EF#$BB#$BF then Offset := 4;
+  if (Offset <= Length(Buffer)) and (Buffer[Offset] = '#') then
+    while (Offset <= Length(Buffer)) and (Buffer[Offset] <> #10) do Inc(Offset);
+  ChunkName := '@' + AFileName;
+  Result := luaL_loadbuffer(L, PAnsiChar(Buffer) + Offset - 1,
+    Length(Buffer) - Offset + 1, PAnsiChar(ChunkName));
+end;
+
 function LuaLoadFromStreamOrFile(const L: Plua_State;
   const AStream: TMemoryStream; const AFileName: String): Integer;
 begin
   if (not AlwaysLoadLuaFromFile) and (AStream <> nil) then
     Result := luaL_loadbuffer(L, AStream.Memory, AStream.Size, PAnsiChar(AFileName))
   else
-    Result := luaL_loadfile(L, PAnsiChar(AFileName));
+    Result := LuaLoadFileUTF8(L, AFileName);
 end;
 
 procedure LuaExecute(const L: Plua_State; const AStream: TMemoryStream;
