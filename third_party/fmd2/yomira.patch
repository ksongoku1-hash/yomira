+function IsYomiraStagingPath(const APath: String): Boolean;
+var
+  Root, Target: String;
+begin
+  Root := GetEnvironmentVariable('YOMIRA_FMD2_STAGING_ROOT');
+  if Root = '' then
+    Root := USERDATA_FOLDER + 'yomira-staging';
+  Root := IncludeTrailingPathDelimiter(ExpandFileName(Root));
+  Target := IncludeTrailingPathDelimiter(ExpandFileName(APath));
+  Result := SameText(Copy(Target, 1, Length(Root)), Root);
+end;
